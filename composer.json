{
  "name": "anil/file-export",
  "description": "A powerful, fluent file export package for Laravel built on top of Maatwebsite/Excel",
  "keywords": [
    "anil",
    "csv",
    "excel",
    "export",
    "laravel",
    "laravel-excel",
    "maatwebsite",
    "pdf"
  ],
  "autoload": {
    "psr-4": {
      "Anil\\FileExport\\": "src/"
    }
  },
  "authors": [
    {
      "name": "anil kumar thakur",
      "email": "anilkumarthakur60@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "maatwebsite/excel": "^3.1"
  },
  "require-dev": {
    "larastan/larastan": "^2.0||^3.0",
    "orchestra/testbench": "^8.0||^9.0||^10.0"
  },
  "suggest": {
    "mpdf/mpdf": "Required for PDF export format support"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Anil\\FileExport\\Providers\\ExportServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true
}
