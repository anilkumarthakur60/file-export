{
  "name": "anil/file-export",
  "description": "A powerful, fluent file export package for Laravel, built on PhpSpreadsheet with its own export engine.",
  "keywords": [
    "anil",
    "csv",
    "excel",
    "export",
    "laravel",
    "phpspreadsheet",
    "spreadsheet",
    "multi-sheet",
    "ods",
    "pdf"
  ],
  "autoload": {
    "psr-4": {
      "Anil\\FileExport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Anil\\FileExport\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "anil kumar thakur",
      "email": "anilkumarthakur60@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/bus": "^11.0|^12.0|^13.0",
    "illuminate/contracts": "^11.0|^12.0|^13.0",
    "illuminate/filesystem": "^11.0|^12.0|^13.0",
    "illuminate/http": "^11.0|^12.0|^13.0",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "laravel/serializable-closure": "^1.3|^2.0|^3.0",
    "phpoffice/phpspreadsheet": "^1.30|^2.0|^3.0"
  },
  "require-dev": {
    "larastan/larastan": "^2.0||^3.0",
    "mpdf/mpdf": "^8.2",
    "orchestra/testbench": "^9.0||^10.0",
    "pestphp/pest": "^3.0||^4.0",
    "phpunit/phpunit": "^10.0||^11.0||^12.0"
  },
  "suggest": {
    "mpdf/mpdf": "Required for PDF export (alternatively dompdf/dompdf or tecnickcom/tcpdf)",
    "dompdf/dompdf": "Alternative PDF rendering driver",
    "tecnickcom/tcpdf": "Alternative PDF rendering driver"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Anil\\FileExport\\Providers\\FileExportServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "test": "vendor/bin/pest"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true
}
